# Copy this file to .env and fill in your keys. Never commit .env.

# LLM: "groq" (free key: https://console.groq.com/keys) or "gemini" (free key: https://aistudio.google.com/apikey)


LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Use a different provider for the evaluation judge to reduce self-grading bias (optional)
JUDGE_PROVIDER=groq

# Web search fallback (free key: https://app.tavily.com)
TAVILY_API_KEY=

# Retrieval settings (tune these in experiments)
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
